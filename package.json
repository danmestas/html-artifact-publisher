{
  "name": "html-artifact-publisher",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:wasm": "sh fossil/build.sh",
    "types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:go": "cd fossil && go vet ./... && go test ./...",
    "deploy:prod": "doppler run --project html-artifact-publisher --config prd -- sh scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "binaryen": "132.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.152.0"
  },
  "type": "module",
  "overrides": {
    "undici": "7.30.1"
  }
}
