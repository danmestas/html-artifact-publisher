{
  "name": "html-artifact-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "routes": [
    {
      "pattern": "example.com",
      "custom_domain": true
    }
  ],

  // The viewer shell, its scripts and the Fossil wasm. Requests the Worker
  // handles itself (the API, the byte store, the viewer route) skip the
  // asset lookup.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/a/*", "/v/*", "/healthz"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "html-artifact-publisher",
      // Replace with real database_id after `wrangler d1 create html-artifact-publisher`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // BEARER_TOKEN is a secret — set it with: wrangler secret put BEARER_TOKEN
  // It is NOT declared in vars; `wrangler types` will include it from the stub.

  "vars": {
    "PUBLIC_BASE_URL": "https://example.com",
    // Maximum TTL in seconds (30 days)
    "MAX_TTL_SECONDS": "2592000",
    // Default TTL when not specified (7 days)
    "DEFAULT_TTL_SECONDS": "604800",
    // Maximum payload size in bytes (10 MB)
    "MAX_PAYLOAD_BYTES": "10485760",
    // Optional agent wake-up through notify (see README). NOTIFY_API_KEY is a secret.
    "NOTIFY_URL": "",
    "NOTIFY_AGENT": "",
    "NOTIFY_SUBSCRIBER": ""
  }
}
