{
  "name": "html-artifact-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Served at https://html-artifact-publisher.<your-subdomain>.workers.dev.
  // For a custom domain add: "routes": [{ "pattern": "<your-domain>", "custom_domain": true }]
  "workers_dev": true,

  // The viewer shell. Requests the Worker answers itself skip the asset lookup.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/login", "/api/*", "/r/*", "/v/*", "/p/*", "/healthz"]
  },

  // go-libfossil compiled to wasm by fossil/build.sh.
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],

  // Every artifact is a Fossil repository in its own SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "Repo" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Repo", "Registry"] }
  ],

  // BEARER_TOKEN is a secret — set it with: wrangler secret put BEARER_TOKEN
  // NOTIFY_API_KEY (optional) is a secret too.

  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // Installation-specific values are supplied by scripts/deploy.sh from Doppler.
    "APP_ORIGIN": "",
    "EMAIL_FROM": "",
    // Never enable outside an isolated localhost test server.
    "TEST_MAIL_TRANSPORT": "",
    // Maximum TTL in seconds (30 days)
    "MAX_TTL_SECONDS": "2592000",
    // Default TTL when not specified (7 days)
    "DEFAULT_TTL_SECONDS": "604800",
    // Maximum request body in bytes (10 MB)
    "MAX_PAYLOAD_BYTES": "10485760",
    // Optional agent wake-up through notify (see README).
    "NOTIFY_URL": "",
    "NOTIFY_AGENT": "",
    "NOTIFY_SUBSCRIBER": ""
  }
}
